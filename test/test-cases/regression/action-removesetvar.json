      },
      "uri": "/a=urlencoded?param1=value1",
      "method": "GET",
      "body": [ "" ]
    },
    "response": {
      "headers": { "Content-Type": "text/html", "Content-Length": "8" },
      "body": [ "no need." ]
    },
    "expected": {
      "http_code": 200,
      "error_log": "kept-other"
    },
    "rules": [
      "SecRuleEngine On",
      "SecAction \"id:1,phase:1,nolog,pass,setvar:tx.inbound_anomaly_score_pl1=5,setvar:tx.inbound_anomaly_score_pl2=3,setvar:tx.other=7\"",
      "SecAction \"id:2,phase:1,nolog,pass,removesetvar:/tx.inbound_anomaly_score_.*/\"",
